{% doc %}
  @prompt
    a blue authentic tick
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-authentic-tick-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.font.family }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.2;
  }

  .ai-authentic-tick-{{ ai_gen_id }}__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-authentic-tick-{{ ai_gen_id }}__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-authentic-tick-{{ ai_gen_id }}__label {
    margin: 0;
    font-weight: 600;
  }

  .ai-authentic-tick-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: none;
  }

  .ai-authentic-tick-{{ ai_gen_id }}__link:hover,
  .ai-authentic-tick-{{ ai_gen_id }}__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstyle %}

<div
  class="ai-authentic-tick-{{ ai_gen_id }}"
  role="img"
  aria-label="{{ block.settings.label | escape }}"
  {{ block.shopify_attributes }}
>
  <span class="ai-authentic-tick-{{ ai_gen_id }}__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2.5L14.6 4.1L17.6 4.2L18.8 6.9L21.1 8.8L20.4 11.7L21.1 14.6L18.8 16.5L17.6 19.2L14.6 19.3L12 20.9L9.4 19.3L6.4 19.2L5.2 16.5L2.9 14.6L3.6 11.7L2.9 8.8L5.2 6.9L6.4 4.2L9.4 4.1L12 2.5Z" fill="currentColor"/>
      <path d="M7.8 11.8L10.5 14.5L16.3 8.7" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  {% if block.settings.link != blank %}
    <a class="ai-authentic-tick-{{ ai_gen_id }}__link" href="{{ block.settings.link }}">
      <span class="ai-authentic-tick-{{ ai_gen_id }}__label">{{ block.settings.label }}</span>
    </a>
  {% else %}
    <span class="ai-authentic-tick-{{ ai_gen_id }}__label">{{ block.settings.label }}</span>
  {% endif %}
</div>

{% schema %}
{
  "name": "Authentic tick",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Authentic"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "poppins_n5"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#1877F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Authentic tick"
    }
  ],
  "tag": null,
  "class": "authentic-tick-block"
}
{% endschema %}