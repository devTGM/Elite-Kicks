<style>
  .trust-features {
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
    overflow: hidden;
  }

  .trust-features__container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;

    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;

    padding: 36px 3vw;
    box-sizing: border-box;
  }

  .trust-feature {
    flex: 1 1 0;
    min-width: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    text-align: center;

    padding: 0 2vw;
    box-sizing: border-box;

    cursor: pointer;
  }

  /* Icon */
  .trust-feature__icon {
    width: clamp(52px, 4.2vw, 80px);
    height: clamp(52px, 4.2vw, 80px);

    border-radius: 50%;

    background: #f7f7f7;
    color: #e53935;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: clamp(10px, 1.2vw, 20px);

    flex-shrink: 0;

    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .trust-feature__icon svg {
    width: clamp(22px, 1.65vw, 31px);
    height: clamp(22px, 1.65vw, 31px);

    display: block;
  }

  /* Heading */
  .trust-feature__content h3 {
    margin: 0 0 clamp(5px, 0.55vw, 10px);

    font-size: clamp(13px, 1.05vw, 20px);
    line-height: 1.25;

    font-weight: 700;

    color: #111111;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    transition: color 0.25s ease;
  }

  /* Description */
  .trust-feature__content p {
    margin: 0;

    font-size: clamp(10px, 0.82vw, 16px);
    line-height: 1.4;

    color: #777777;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    transition: color 0.25s ease;
  }


  /* HOVER */
  .trust-feature:hover .trust-feature__icon {
    background: #e53935;
    color: #ffffff;
    transform: translateY(-3px);
  }

  .trust-feature:hover .trust-feature__content h3 {
    color: #e53935;
  }

  .trust-feature:hover .trust-feature__content p {
    color: #e53935;
  }


  /* Medium screens */
  @media screen and (max-width: 900px) {
    .trust-features__container {
      padding: 28px 1.5vw;
    }
    .trust-feature {
      padding: 0 1vw;
    }
  }


  /* Smaller screens (Mobile Fix) */
  @media screen and (max-width: 600px) {
    .trust-features__container {
      padding: 24px 8px;
      flex-wrap: wrap; /* Allows layout to break into multiple rows */
      row-gap: 20px; /* Spacing between top and bottom rows */
    }

    .trust-feature {
      padding: 0 5px;
      flex: 0 0 50%; /* Creates a clean 2x2 grid */
    }

    .trust-feature__icon {
      width: 44px; /* Shrunk down for mobile */
      height: 44px;
      margin-bottom: 8px;
    }

    .trust-feature__icon svg {
      width: 20px;
      height: 20px;
    }
    
    .trust-feature__content h3,
    .trust-feature__content p {
      white-space: normal; /* Lets text wrap instead of getting cut off by ellipses */
      overflow: visible;
    }
  }
</style>


{% schema %}
{
  "name": "Trust features",
  "settings": [
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "100% Authentic"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "Description",
      "default": "Verified before dispatch."
    },

    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Tracked Shipping"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "Description",
      "default": "Live order tracking."
    },

    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Secure Payments"
    },
    {
