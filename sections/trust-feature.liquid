    },

    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Title",
      "default": "Best Price"
    },
    {
      "type": "text",
      "id": "feature_4_text",
      "label": "Description",
      "default": "Competitive pricing."
    }
  ],
  "presets": [
    {
      "name": "Trust features"
    }
  ]
}
{% endschema %}