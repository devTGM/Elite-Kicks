{% doc %}
  @prompt
    a banner i will provide the image, cover full width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-banner-{{ ai_gen_id }}{display:block;position:relative;width:100%;max-width:{{ block.settings.desktop_width_percent }}%;margin:0 auto;overflow:hidden;background:{{ block.settings.background_color }}}
.ai-banner-{{ ai_gen_id }}__link,.ai-banner-{{ ai_gen_id }}__media{display:block;position:relative;width:100%}
.ai-banner-{{ ai_gen_id }}__media img,.ai-banner-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:{{ block.settings.banner_height }}px;object-fit:cover}
.ai-banner-{{ ai_gen_id }}__placeholder{color:#666;background:#f3f3f3}.ai-banner-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}
.ai-banner-{{ ai_gen_id }}__overlay{position:absolute;inset:0;display:flex;align-items:{{ block.settings.vertical_alignment }};justify-content:{{ block.settings.horizontal_alignment }};padding:32px;background:{{ block.settings.overlay_color }}}
.ai-banner-{{ ai_gen_id }}__content{max-width:560px;color:{{ block.settings.text_color }};text-align:{{ block.settings.text_alignment }}}
.ai-banner-{{ ai_gen_id }}__heading{margin:0 0 10px;font-size:{{ block.settings.heading_size }}px;line-height:1.1;font-weight:600}.ai-banner-{{ ai_gen_id }}__text{margin:0 0 18px;font-size:16px;line-height:1.5}
.ai-banner-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};border:1px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;font-size:14px;font-weight:600;text-decoration:none}
.ai-banner-{{ ai_gen_id }}__button:focus-visible,.ai-banner-{{ ai_gen_id }}__link:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}
@media screen and (max-width:749px){.ai-banner-{{ ai_gen_id }}{max-width:100%}.ai-banner-{{ ai_gen_id }}__media img,.ai-banner-{{ ai_gen_id }}__placeholder{height:{{ block.settings.mobile_height }}px}.ai-banner-{{ ai_gen_id }}__overlay{padding:24px}.ai-banner-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}}
{% endstyle %}
<div class="ai-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.banner_link != blank %}<a class="ai-banner-{{ ai_gen_id }}__link" href="{{ block.settings.banner_link }}">{% endif %}
{% if block.settings.image != blank %}<div class="ai-banner-{{ ai_gen_id }}__media"><img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"></div>{% else %}<div class="ai-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
{% if block.settings.show_overlay %}<div class="ai-banner-{{ ai_gen_id }}__overlay"><div class="ai-banner-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h2 class="ai-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.text != blank %}<p class="ai-banner-{{ ai_gen_id }}__text">{{ block.settings.text | escape }}</p>{% endif %}{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div></div>{% endif %}
{% if block.settings.banner_link != blank %}</a>{% endif %}</div>
{% schema %}{"name":"Image banner","settings":[{"type":"header","content":"Banner image"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"banner_link","label":"Banner link"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"banner_height","label":"Height","min":160,"max":700,"step":20,"unit":"px","default":420},{"type":"range","id":"mobile_height","label":"Mobile height","min":140,"max":500,"step":20,"unit":"px","default":280},{"type":"header","content":"Overlay content"},{"type":"checkbox","id":"show_overlay","label":"Show overlay","default":true},{"type":"text","id":"heading","label":"Heading","default":"Step into something new"},{"type":"textarea","id":"text","label":"Text","default":"Discover the latest styles from Elite Kicks Co."},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"horizontal_alignment","label":"Horizontal alignment","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"vertical_alignment","label":"Vertical alignment","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"radio","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":72,"step":4,"unit":"px","default":44},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":48,"step":2,"unit":"px","default":30},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#f3f3f3"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#00000066"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#ffffff"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":0}],"presets":[{"name":"Image banner"}],"tag":null,"class":"image-banner-block"}{% endschema %}